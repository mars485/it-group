---
import Base from '../layouts/Base.astro';
import LeadForm from '../components/LeadForm.astro';
const services=[['Разработка сайтов','/razrabotka-sajtov/','Лендинги, корпоративные сайты и интернет-магазины.'],['Продвижение и реклама','/prodvizhenie-i-reklama/','Поисковое продвижение, контекстная реклама и аналитика.'],['Сайты для недвижимости','/sajty-dlya-agentstv-nedvizhimosti/','Каталоги объектов, формы и интеграции с CRM.']];
---
<Base title="IT GROUP — сайты, реклама и автоматизация" description="Разработка сайтов, реклама, аналитика и автоматизация для малого бизнеса.">
<section class="hero"><div class="container hero-grid"><div class="hero-copy"><p class="eyebrow"><span class="eyebrow-line"></span> IT GROUP · цифровая система для бизнеса</p><h1>Разрабатываем сайты, которые помогают <span class="gradient-text">получать клиентов</span></h1><p class="hero-lead">Создаём сайты, настраиваем рекламу, аналитику и автоматизацию. Особая экспертиза — цифровые решения для агентств недвижимости.</p><div class="hero-actions"><a class="button button-primary" href="#form">Обсудить проект ↗</a><a class="button button-secondary" href="#form">Получить бесплатный разбор</a></div><div class="hero-note"><span class="pulse"></span> От первой идеи до запуска и сопровождения</div></div><div class="hero-art" aria-label="Схема цифровой воронки продаж"><div class="art-glow"></div><img class="hero-network-art" src="/graphics/growth-network.svg" alt="" aria-hidden="true"/><div class="dashboard"><div class="dash-top"><span class="dash-brand">itgroup / growth</span><span class="dash-period">СХЕМА РАБОТЫ</span></div><div class="dash-title">Путь клиента</div><div class="funnel">{[['Трафик','Поиск · реклама · рекомендации'],['Сайт','Понятное предложение и форма'],['Заявка','Звонок · мессенджер · обращение'],['CRM и следующий контакт','Заявка не теряется после отправки']].map(([title,subtitle],i)=><div class="funnel-row"><b class="funnel-icon">{['↗','◎','✳','↻'][i]}</b><div><strong>{title}</strong><small>{subtitle}</small></div><span>{String(i+1).padStart(2,'0')}</span></div>)}</div><div class="dash-foot">Единая система продаж · IT GROUP</div></div></div></div></section>
<section class="trust-strip"><div class="container trust-items"><span class="trust-item">Полный цикл разработки</span><span class="trust-item">Клиенты по всей России</span><span class="trust-item">Фокус на недвижимости</span><span class="trust-item">Месяц бесплатных правок</span></div></section>
<section class="section services-section"><div class="container"><div class="section-heading"><p class="eyebrow">ЧТО ДЕЛАЕМ</p><h2>Цифровые решения под вашу задачу</h2></div><div class="service-grid">{services.map(([title,url,description],i)=><a class="service-card" href={url}><span class="service-number">0{i+1}</span><span class="service-arrow">↗</span><h3>{title}</h3><p>{description}</p><span class="card-link">Подробнее →</span></a>)}</div></div></section>
<section class="section flow-section"><div class="container"><div class="section-heading center-heading"><p class="eyebrow">СИСТЕМА ПРОДАЖ</p><h2>От первого касания до следующего контакта</h2></div><div class="flow">{['Трафик','Сайт','Обращение','CRM','Follow-up'].map((step,i)=><div class="flow-step"><small>0{i+1}</small><b>{step}</b></div>)}</div></div></section>
<section class="section" id="form"><div class="container"><div class="section-heading"><p class="eyebrow">ОБСУДИМ ПРОЕКТ</p><h2>Расскажите о своей задаче</h2><p class="section-intro">Опишите задачу — подготовим предварительный план работ.</p><LeadForm /></div></div></section>
</Base>
