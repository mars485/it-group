---
const { title = 'IT GROUP — разработка сайтов', description = 'Разработка сайтов, реклама и автоматизация для бизнеса.' } = Astro.props;
const nav = [['Услуги','/uslugi/'],['Недвижимость','/sajty-dlya-agentstv-nedvizhimosti/'],['Кейсы','/kejsy/'],['О студии','/o-studii/'],['Контакты','/kontakty/']];
---
<!doctype html>
<html lang="ru"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>{title}</title><meta name="description" content={description}/><link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)}/><link rel="icon" href="/favicon.svg"/><link rel="stylesheet" href="/css/site.css"/></head>
<body><a class="skip-link" href="#main">К содержанию</a><header class="site-header"><div class="container nav-wrap"><a class="brand" href="/"><span class="brand-mark"><img class="brand-lion" src="/graphics/it-group-lion.png" alt=""/></span><span class="brand-name"><span class="brand-name-it">IT</span> GROUP</span></a><button class="menu-toggle" aria-expanded="false" aria-controls="main-nav">Меню</button><nav id="main-nav" class="main-nav" aria-label="Основная навигация">{nav.map(([name,href])=><a href={href}>{name}</a>)}</nav><a class="header-cta" href="/#form">Обсудить проект ↗</a></div></header><main id="main"><slot /></main><footer class="site-footer"><div class="container footer-grid"><div><a class="brand" href="/">IT GROUP</a><p class="muted">Сайты, продвижение и автоматизация для бизнеса.</p></div><div><strong>Разделы</strong>{nav.map(([name,href])=><a href={href}>{name}</a>)}</div><div><strong>Связаться</strong><a href="/kontakty/">Контакты</a></div></div><div class="container footer-bottom"><span>© IT GROUP, {new Date().getFullYear()}</span><a href="/politika-konfidencialnosti/">Политика конфиденциальности</a><span>Работаем по всей России</span></div></footer><script src="/js/site.js" defer></script></body></html>
